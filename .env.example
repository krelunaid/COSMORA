# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Server-only secrets — never commit real values
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
REMOVE_BG_API_KEY=REPLACE_ME
# Optional server-only Apple token revocation. Use the same Services ID as
# Supabase Apple OAuth and a current Apple client-secret JWT; rotate before expiry.
# If absent, legacy accounts still delete with the TN3194 manual revocation flow.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

APP_URL=http://localhost:3000
